From: =?utf-8?b?Ik1hcmNvIFRyZXZpc2FuIChUcmV2acOxbyki?= <mail@3v1n0.net>
Date: Thu, 4 Dec 2025 03:34:18 +0100
Subject: build: Use the symbol file for legacy library too

This implies breaking the ABI as per commit 80c317e59d7135

Origin: https://gitlab.gnome.org/GNOME/gnome-desktop/-/commit/ddaa0e8
---
 libgnome-desktop/meson.build | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/libgnome-desktop/meson.build b/libgnome-desktop/meson.build
index a18683e..222fb40 100644
--- a/libgnome-desktop/meson.build
+++ b/libgnome-desktop/meson.build
@@ -250,6 +250,8 @@ if get_option('legacy_library')
     version: compat_libversion,
     c_args: libargs,
     link_args: compat_ldflags,
+    link_args: base_ldflags,
+    link_depends: base_symbol_map_file,
     install: true,
     include_directories: [
       include_directories('.'),
