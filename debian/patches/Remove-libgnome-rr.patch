-	guint i;
-
-	gtk_init (&argc, &argv);
-	screen = gnome_rr_screen_new (gdk_screen_get_default (), &error);
-	if (screen == NULL) {
-		g_warning ("failed to get screen: %s", error->message);
-		g_error_free (error);
-		goto out;
-	}
-	outputs = gnome_rr_screen_list_outputs (screen);
-	for (i = 0; outputs[i] != NULL; i++)
-		print_output (outputs[i], NULL);
