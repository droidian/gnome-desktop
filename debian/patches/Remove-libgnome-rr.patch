-        rr_screen = g_initable_new (GNOME_RR_TYPE_SCREEN, NULL, error, "gdk-display", display, NULL);
-        if (rr_screen) {
-            g_object_set_data (G_OBJECT (display), "-gnome-rr-screen-display", rr_screen);
