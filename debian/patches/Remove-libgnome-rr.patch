-static ScreenInfo *
-screen_info_new (GnomeRRScreen *screen, GError **error)
-{
-    ScreenInfo *info = g_new0 (ScreenInfo, 1);
-
-    g_assert (screen != NULL);
-
-    info->outputs = NULL;
-    info->crtcs = NULL;
-    info->modes = NULL;
-    info->screen = screen;
-    
-    if (fill_out_screen_info (info, error))
-    {
-	return info;
-    }
-    else
-    {
-	screen_info_free (info);
-	return NULL;
-    }
