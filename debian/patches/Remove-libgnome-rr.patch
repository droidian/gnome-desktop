-    if (fill_out_screen_info (info, error))
-    {
-        return info;
-    }
-    else
-    {
-        screen_info_free (info);
-        return NULL;
-    }
-}
-
-static GnomeRROutput *
-find_output_by_winsys_id (GnomeRROutput **haystack, glong winsys_id)
-{
-    guint i;
-
-    for (i = 0; haystack[i] != NULL; i++)
-    {
-        if (haystack[i]->winsys_id == winsys_id)
-            return haystack[i];
-    }
