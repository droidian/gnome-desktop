-      { GNOME_RR_DPMS_ON, "GNOME_RR_DPMS_ON", "on" },
-      { GNOME_RR_DPMS_STANDBY, "GNOME_RR_DPMS_STANDBY", "standby" },
-      { GNOME_RR_DPMS_SUSPEND, "GNOME_RR_DPMS_SUSPEND", "suspend" },
-      { GNOME_RR_DPMS_OFF, "GNOME_RR_DPMS_OFF", "off" },
