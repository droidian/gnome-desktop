From: =?utf-8?b?Ik1hcmNvIFRyZXZpc2FuIChUcmV2acOxbyki?= <mail@3v1n0.net>
Date: Wed, 4 Feb 2026 21:02:18 +0100
Subject: gnome-bg-slide-show: Chain-up the finalize method

We were leaking the actual GObject data

Origin: https://gitlab.gnome.org/GNOME/gnome-desktop/-/commit/12a6ab4
---
 libgnome-desktop/gnome-bg-slide-show.c          | 2 ++
 libgnome-desktop/gnome-bg/gnome-bg-slide-show.c | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/libgnome-desktop/gnome-bg-slide-show.c b/libgnome-desktop/gnome-bg-slide-show.c
index 97efde3..fc617e8 100644
--- a/libgnome-desktop/gnome-bg-slide-show.c
+++ b/libgnome-desktop/gnome-bg-slide-show.c
@@ -167,6 +167,8 @@ gnome_bg_slide_show_finalize (GObject *object)
         g_queue_free_full (self->priv->stack, g_free);
 
         g_object_unref (self->priv->file);
+
+        G_OBJECT_CLASS (gnome_bg_slide_show_parent_class)->finalize (object);
 }
 
 static void
diff --git a/libgnome-desktop/gnome-bg/gnome-bg-slide-show.c b/libgnome-desktop/gnome-bg/gnome-bg-slide-show.c
index 97efde3..fc617e8 100644
--- a/libgnome-desktop/gnome-bg/gnome-bg-slide-show.c
+++ b/libgnome-desktop/gnome-bg/gnome-bg-slide-show.c
@@ -167,6 +167,8 @@ gnome_bg_slide_show_finalize (GObject *object)
         g_queue_free_full (self->priv->stack, g_free);
 
         g_object_unref (self->priv->file);
+
+        G_OBJECT_CLASS (gnome_bg_slide_show_parent_class)->finalize (object);
 }
 
 static void
